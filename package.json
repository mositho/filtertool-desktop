{
  "name": "filtertool-desktop",
  "version": "1.0.0",
  "author": "mositho",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "node scripts/wails.mjs dev --dev-profile -config build/config.yml -port 5173",
    "dev:personal": "node scripts/wails.mjs dev -config build/config.yml -port 5173",
    "build": "node scripts/build.mjs",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "check": "node scripts/check-version.mjs && npm run frontend:typecheck && go test ./... && npm test && npm run format:check",
    "test": "vitest run",
    "format": "prettier --write . && npm run format:go",
    "format:go": "go run ./cmd/gofmtcheck -w",
    "format:check": "prettier --check . && go run ./cmd/gofmtcheck",
    "update-basetypes": "go run ./cmd/update-basetypes",
    "generate-data": "go run ./cmd/generate-data"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.go": "gofmt -w"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0",
    "primevue": "^5.0.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  }
}
